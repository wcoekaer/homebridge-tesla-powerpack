{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "lib": ["ES2022"], "rootDir": "src", "outDir": "dist",
    "strict": true, "esModuleInterop": true, "declaration": true,
    "sourceMap": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
